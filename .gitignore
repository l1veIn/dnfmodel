# Code, configuration, prompts and documents are versioned. Generated output, game-derived assets and media stay on disk only.

# Generated output: NPKs, frames, previews, release packages (several GB)
output/
validation/roundtrip/

# Copies and extracts of the official game resources
sources/
materials/
dnf刃/

# Third-party tools and downloads (Krita, vendor sources)
tools/

# Resource library: the SQLite cache is rebuilt by scripts/dnf_kb.py; community data is kept local (COLG table is for personal use only)
kb/kb.sqlite
kb/scan.log
kb/sources/

